{
  "name": "sprint_mission_3",
  "version": "4.0.1",
  "description": "중고마켓/자유게시판 API 서버",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "nodemon --watch src --exec \"ts-node --files src/server.ts\"",
    "build": "tsc",
    "prisma:push": "npx prisma db push",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "dotenv -e .env.test -- jest",
    "test:watch": "dotenv -e .env.test -- jest --watch",
    "test:coverage": "dotenv -e .env.test -- jest --coverage",
    "test:setup": "dotenv -e .env.test -- npm run prisma:migrate && dotenv -e .env.test -- npm run prisma:seed",
    "badge": "coverage-badges",
    "test:badge": "npm run test:coverage && npm run badge",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "license": "김준철",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-jwt": "^8.5.1",
    "is-email": "^1.0.2",
    "is-uuid": "^1.0.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "superstruct": "^1.0.3",
    "tsx": "^4.20.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-jwt": "^6.0.4",
    "@types/is-email": "^1.0.0",
    "@types/is-uuid": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "coverage-badges-cli": "^2.2.0",
    "dotenv-cli": "^10.0.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
